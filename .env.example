# Canonical site URL — used for sitemap, robots and Open Graph metadata.
# Leave unset to use https://olietintellect.com (the future production domain).
# Set to "https://your-app.vercel.app" while testing on Vercel.
NEXT_PUBLIC_SITE_URL=

# Sanity — leave unset to run on the bundled seed content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-06
# Optional server-side token (required for draft/preview content)
SANITY_API_TOKEN=